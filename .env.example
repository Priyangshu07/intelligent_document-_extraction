# Application Settings
APP_NAME="Financial Document Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL="INFO"

# Database - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/docai"

# AI Provider Configuration
# Supported: openai, anthropic, google
AI_PROVIDER="google"
AI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="..."

# AI Request Settings
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# File Upload Settings
MAX_FILE_SIZE_MB=20
MAX_PAGES=3

# Financial Validation Tolerance
VALIDATION_ABS_TOLERANCE=1.0
VALIDATION_REL_TOLERANCE=0.005

# CORS
CORS_ORIGINS="*"
